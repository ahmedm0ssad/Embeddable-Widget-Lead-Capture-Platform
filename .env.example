DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://host:6380/0
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_publishable_key
SUPABASE_SERVICE_KEY=your_service_role_key
GROQ_API_KEY=your_groq_api_key
IPINFO_TOKEN=your_ipinfo_token
# Comma-separated CIDRs of proxies you trust to set X-Forwarded-For.
# LEAVE EMPTY to keep the direct TCP peer as the client IP (secure default).
# Only set this when the app is behind a reverse proxy that overwrites XFF.
TRUSTED_PROXY_CIDRS=
PORT=8000

# LLM provider (OpenAI-compatible; swap providers by changing these three values)
# Groq:  https://api.groq.com/openai/v1     Ollama: http://localhost:11434/v1/  (key: ollama)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=openai/gpt-oss-20b
# LLM_STUB=1 is a dev override: fixed schema-valid answer, no model call
# (checked BEFORE the kill switch).
LLM_STUB=
# LLM_ENABLED=false (or 0/no/off) is the kill switch: deterministic fallback,
# immediate, no model call. Blank/unset means "not configured" -> 503 when stub is off.
LLM_ENABLED=true
# Pre-send token guard: requests whose ESTIMATED token size (system prompt +
# JSON-encoded record, tiktoken o200k_base, ±10%) exceeds this are refused
# with HTTP 400 error=request_too_long BEFORE any model call. 4000 admits
# every schema-valid record (worst case ~2k) while catching runaway inputs.
LLM_MAX_REQUEST_TOKENS=4000
# Opt-in structured output (default off): set to json_schema to ask models
# that support OpenAI-style response_format to enforce the ClassifyOutput
# schema server-side. Unsupported models reject the request (4xx) — set only
# on providers known to accept it.
LLM_RESPONSE_FORMAT=
